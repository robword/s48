# startup48 tools - Apache (DreamHost) settings
Options -Indexes
DirectoryIndex index.php index.html

# Do not serve dotfiles, including the deploy marker
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS only. REQUEST_URI keeps the /s48/ prefix when this folder is served
  # as a subdirectory ($1 would be relative to this folder).
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # Never serve storage, server code or CLI scripts.
  RewriteRule ^(data|inc|bin)(/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "DENY"
  # Pages, styles and scripts revalidate on every load so a deploy shows up without a hard refresh.
  # (Fonts and headshots keep their caching; the PHP endpoints set their own headers.)
  <FilesMatch "\.(html|css|js|svg|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
